# ─────────────────────────────────────────────────────────────────────────────
# Material Search – Environment Variables
#
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is git-ignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" to call the real backend API instead of the built-in mock data.
# When "false" (default), the app runs fully in-browser with generated mock materials.
VITE_USE_REAL_API=false

# Base URL of the MDG backend (no trailing slash). Only used when VITE_USE_REAL_API=true.
#
# Paths in code are absolute: /api/materials/fields, /api/materials/search, …
# Final URL = VITE_API_BASE_URL + path
#
# Local dev (npm run dev):
#   Leave EMPTY — Vite proxy (vite.config.ts) forwards /api → https://mdg.dev.erp.idf
#
# UI hosted on GW, API on MDG (typical deploy):
#   VITE_API_BASE_URL=https://mdg.dev.erp.idf
#   → GET https://mdg.dev.erp.idf/api/materials/fields
#   Empty base here hits GW host → 404 (API is not on GW).
#   Cross-origin needs MDG CORS for the GW UI origin, or a reverse proxy on GW for /api.
#
# UI and API same host:
#   Leave EMPTY only if that host actually serves /api/materials/*
VITE_API_BASE_URL=

# Results page size for infinite scroll (default 80).
# VITE_PAGE_SIZE=80

# Optional HTTP Basic auth (only if your gateway requires it).
# Prefer cookie/session SSO via withCredentials; do NOT commit real secrets.
# VITE_API_BASIC_USER=
# VITE_API_BASIC_PASSWORD=

# External "דוח שגויים" app — opened when user clicks that button with selected rows.
# MATNRs are sent via window.postMessage (type: MDG_MATERIAL_SEARCH_SELECTION).
# VITE_ERRORS_REPORT_URL=https://example.com/errors-report
# Optional strict origin for postMessage (defaults to origin of the URL above).
# VITE_ERRORS_REPORT_ORIGIN=https://example.com

# Open material in SAP MDG (detail dialog button).
# GET path template; {matnr} is replaced. Default: /api/materials/{matnr}/mdg-url
# Optional query: ?werks= when plant is known from the result row.
# Response: { "url": "https://..." } (also accepts url/URL/link/href or plain string body).
# VITE_MDG_OPEN_URL_PATH=/api/materials/{matnr}/mdg-url
