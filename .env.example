# ─────────────────────────────────────────────────────────────────────────────
# Material Search – Environment Variables
#
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is git-ignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" to call the real backend API instead of the built-in mock data.
# When "false" (default), the app runs fully in-browser with generated mock materials.
VITE_USE_REAL_API=false

# Base URL of the backend server (no trailing slash).
# Only used when VITE_USE_REAL_API=true.
VITE_API_BASE_URL=http://localhost:8080
